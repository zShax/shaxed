# Copy to .env and fill in. Never commit .env.

# Port the site listens on (inside the container too)
PORT=3000

# Public address, no trailing slash. Used for canonical links and the RSS feed.
SITE_URL=https://shaxed.com

# Password for /admin, 8+ characters. Leave empty to switch the admin off.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string:  openssl rand -hex 32
SESSION_SECRET=

# Where blog.db lives. The Docker setup mounts ./data here.
DATA_DIR=data
